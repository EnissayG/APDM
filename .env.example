# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinataire des notifications (équipe APDM)
CONTACT_TO_EMAIL=bonjour@apdm.ca

# Expéditeur vérifié dans Resend (domaine authentifié)
CONTACT_FROM_EMAIL=APDM <bonjour@apdm.ca>

# URL publique du site (logo dans les courriels)
SITE_URL=https://votresite.netlify.app

# Optionnel — endpoint du formulaire (défaut: "/")
# Utile si le front est sur GitHub Pages et les Forms sur Netlify :
# VITE_FORM_ENDPOINT=https://votresite.netlify.app/
